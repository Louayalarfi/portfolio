{
  "name": "lauaialerfi-portfolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "lauaialerfi.com, a 3D zoom into the machine portfolio with the classic page as fallback",
  "scripts": {
    "content": "node tools/extract-content.mjs",
    "lint": "node tools/lint-style.mjs",
    "dev": "vite",
    "prebuild": "npm run content && npm run lint",
    "build": "vite build",
    "postbuild": "node tools/check-budget.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "shot": "node tools/shot.mjs"
  },
  "dependencies": {
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "vite": "^5.2.0"
  }
}
